// prisma/schema.prisma
// Schema completo do TechRadar — hub de buscas de tecnologia

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuário e Autenticação (NextAuth v5 / Auth.js) ──────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER")
  password      String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  favorites     Favorite[]
  searchLogs    SearchLog[]
  flashcards    Flashcard[]
  studyNotes    StudyNote[]
  tags          Tag[]
  exercises     Exercise[]
  codeErrors    CodeError[]
  mindMaps      MindMap[]
  libraryItems  LibraryItem[]
  bookmarks     Bookmark[]
  documents     Document[]
  highlights    Highlight[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Skills (dicionário curado) ───────────────────────────────────────────

model Skill {
  id          String   @id @default(cuid())
  slug        String   @unique // ex: "react", "typescript"
  name        String   // ex: "React", "TypeScript"
  category    String   // "frontend" | "backend" | "devops" | "data" | "mobile" | "soft"
  aliases     String[] // ["reactjs", "react.js", "react js"]
  description String?

  jobSkills       JobSkill[]
  courseSkills    CourseSkill[]
  bookSkills      BookSkill[]
  audiobookSkills AudiobookSkill[]
}

// ─── Fontes de Vagas configuráveis via Admin ──────────────────────────────

model JobSource {
  id        String   @id @default(cuid())
  name      String
  url       String
  source    String   // chave que referencia o Job.source (ex: "trampos", "coodesh")
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Conteúdo: Vaga ───────────────────────────────────────────────────────

model Job {
  id          String   @id @default(cuid())
  externalId  String   @unique // ID da fonte (Remotive, Arbeitnow)
  source      String   // "remotive" | "arbeitnow"
  title       String
  company     String
  description String   @db.Text
  url         String
  location    String?  // "Remote", "São Paulo, BR", etc.
  isRemote    Boolean  @default(false)
  jobType     String?  // "full-time" | "contract" | "part-time"
  salaryMin   Int?
  salaryMax   Int?
  currency    String?  @default("USD")
  level       String?  // "junior" | "pleno" | "senior" | "lead"
  postedAt    DateTime?
  expiresAt   DateTime?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills    JobSkill[]

  @@index([title])
  @@index([isRemote])
  @@index([level])
  @@index([isActive])
}

model JobSkill {
  jobId   String
  skillId String
  job     Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

// ─── Conteúdo: Curso ──────────────────────────────────────────────────────

model Course {
  id           String   @id @default(cuid())
  externalId   String   @unique
  source       String   // "classcentral" | "youtube" | "coursera"
  title        String
  provider     String   // "freeCodeCamp", "Coursera", etc.
  description  String   @db.Text
  url          String
  thumbnailUrl String?
  language     String   @default("en")
  isFree       Boolean  @default(true)
  price        Float?
  currency     String?  @default("USD")
  level        String?  // "beginner" | "intermediate" | "advanced"
  duration     String?  // "8h", "4 weeks"
  rating       Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skills    CourseSkill[]

  @@index([title])
  @@index([isFree])
  @@index([language])
}

model CourseSkill {
  courseId String
  skillId  String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseId, skillId])
}

// ─── Conteúdo: Livro ──────────────────────────────────────────────────────

model Book {
  id           String   @id @default(cuid())
  externalId   String   @unique // ISBN ou ID Open Library
  source       String   // "openlibrary" | "googlebooks"
  title        String
  authors      String[]
  description  String?  @db.Text
  url          String
  thumbnailUrl String?
  language     String   @default("en")
  pageCount    Int?
  publishedAt  DateTime?
  publisher    String?
  isFree       Boolean  @default(false) // Open Library = domínio público
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skills    BookSkill[]
  chapters  Chapter[]

  @@index([title])
  @@index([language])
}

model BookSkill {
  bookId  String
  skillId String
  book    Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([bookId, skillId])
}

// ─── Capítulos de livro (leitor dedicado) ────────────────────────────────────

model Chapter {
  id        String   @id @default(cuid())
  bookId    String
  title     String
  order     Int
  pagesStart Int?
  pagesEnd  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]

  @@index([bookId, order])
}

// ─── Marcador de leitura (posição → nota) ────────────────────────────────────

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  itemType  String
  itemId    String
  chapterId String?
  position  Int
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([userId, itemType, itemId])
  @@index([userId, createdAt])
}

// ─── Conteúdo: Audiobook ──────────────────────────────────────────────────

model Audiobook {
  id           String   @id @default(cuid())
  externalId   String   @unique
  source       String   // "librivox" | "audible" | "storytel"
  title        String
  authors      String[]
  narrator     String?
  description  String?  @db.Text
  url          String
  thumbnailUrl String?
  language     String   @default("en")
  durationMin  Int?
  isFree       Boolean  @default(true) // LibriVox = domínio público
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skills    AudiobookSkill[]

  @@index([title])
  @@index([language])
}

model AudiobookSkill {
  audiobookId String
  skillId     String
  audiobook   Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([audiobookId, skillId])
}

// ─── Biblioteca pessoal: livros e audiobooks do usuário ─────────────────────

model LibraryItem {
  id        String   @id @default(cuid())
  userId    String
  itemType  String   // "book" | "audiobook"
  itemId    String   // ID do Book ou Audiobook
  status    String   // "to_read" | "reading" | "completed"
  progress  Int      @default(0) // 0-100
  rating    Int?     // 1-5
  notes     String?  @db.Text
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId, status])
}

// ─── Documentos da biblioteca (PDF/EPUB) ───────────────────────────────────

model Document {
  id        String   @id @default(cuid())
  userId    String
  title     String
  fileType  String   // "pdf" | "epub"
  fileUrl   String   // URL externa ou path local
  fileData  String?  // base64 para MVP (sem bucket externo)
  fileSize  Int
  pageCount Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlights Highlight[]

  @@index([userId])
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  documentId String
  text      String   @db.Text
  page      Int
  position  Json?
  noteId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  note      StudyNote? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([userId, documentId])
  @@index([userId, createdAt])
}

// ─── Favoritos (N:N polimórfico via type + externalId) ───────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  itemType  String   // "job" | "course" | "book" | "audiobook"
  itemId    String   // ID do item no banco
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
}

// ─── Log de buscas (para perfil e recomendações personalizadas) ───────────

model SearchLog {
  id          String   @id @default(cuid())
  userId      String?  // null = usuário anônimo
  query       String
  tab         String   // "vagas" | "cursos" | "livros" | "audiobooks" | "tudo"
  filters     Json?    // Snapshot dos filtros aplicados
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([query])
  @@index([createdAt])
}

// ─── StudyHub: Flashcards e Notas ─────────────────────────────────────────

model Flashcard {
  id            String   @id @default(cuid())
  userId        String
  front         String
  back          String
  sourceNoteId String?
  source        String? // "ai" | "manual" | "code-error" | "note"
  ease          Float    @default(2.5) // fator de facilidade (algoritmo SM-2)
  interval      Int      @default(0) // dias
  repetitions  Int      @default(0)
  status        String   @default("NEW") // "NEW" | "LEARNING" | "REVIEW" | "RELEARN"
  dueDate      DateTime?
  lastReviewedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueDate])
  @@index([userId])
}

model StudyNote {
  id        String   @id @default(cuid())
  userId    String
  title     String   // título da nota
  markdown  String   @db.Text // conteúdo em Markdown
  source    String? // "manual" | "ai" | "book" | "lecture" | "highlight"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags      NoteTag[]
  highlights Highlight[]

  @@index([userId])
  @@index([updatedAt])
}

// ─── Tags para notas (estilo Obsidian) ─────────────────────────────────────

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String   // ex: "React", "middleware", "estudo"
  slug      String   @unique // ex: "react", "middleware"
  color     String? // cor da tag (hex)
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes    NoteTag[]

  @@unique([userId, slug])
  @@index([userId])
}

// ─── Relação N:N Nota ↔ Tag ────────────────────────────────────────────────

model NoteTag {
  noteId String
  tagId  String
  note   StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

// ─── StudyHub: Treino de código ───────────────────────────────────────────

model Exercise {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String   @db.Text
  language     String   @default("typescript")
  starterCode  String   @default("")
  solutionCode String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions CodeSubmission[]

  codeErrors CodeError[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CodeSubmission {
  id          String   @id @default(cuid())
  exerciseId String
  userId      String
  code        String   @db.Text
  aiFeedback String?  @db.Text
  createdAt   DateTime @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model CodeError {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  summary    String   @db.Text
  code       String?  @db.Text
  aiFeedback String?  @db.Text
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

// ─── StudyHub: Mapas Mentais ───────────────────────────────────────────────

model MindMap {
  id        String   @id @default(cuid())
  userId    String
  title     String
  topic     String?
  content   String?  @db.Text
  nodes     Json    @default("[]")
  edges     Json    @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
